+/** Only verified incident recovery (not worker prose) may clear a held permission report. */
+export function verifiedPermissionResolutions(state: FailureState): Array<{ blocker: PermissionBlocker; resolution: "recovered" | "superseded"; resolvedAt: number }> {
+  const resolved = new Map<string, { blocker: PermissionBlocker; resolution: "recovered" | "superseded"; resolvedAt: number }>();
+  for (const incident of failureHistory(state)) {
+    if ((incident.status !== "resolved" && incident.status !== "superseded") ||
+        typeof incident.resolvedAt !== "number" || !Number.isFinite(incident.resolvedAt)) continue;
+    for (const blocker of incident.permissionBlockers ?? []) {
+      if (isPermissionBlocker(blocker) && blocker.incidentId === incident.id) {
+        resolved.set(permissionBlockerKey(blocker), { blocker: { ...blocker },
+          resolution: incident.status === "resolved" ? "recovered" : "superseded", resolvedAt: incident.resolvedAt });
+      }
+    }
+  }
+  return [...resolved.values()];
+}
+
 function closedOrder(a: FailureObservation, b: FailureObservation): number {
   return (b.lastSequence ?? 0) - (a.lastSequence ?? 0) || b.lastObservedAt - a.lastObservedAt;
 }
