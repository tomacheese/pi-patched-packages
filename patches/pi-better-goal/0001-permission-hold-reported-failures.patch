+export interface VerifiedPermissionResolution {
+  blocker: PermissionBlocker;
+  resolution: "recovered" | "superseded";
+  resolvedAt: number;
+}
+
+/** Only the registered worker tool producer may supply recovery evidence. */
+export function reportedPermissionResolutions(pi: ExtensionAPI, toolName: string, details: unknown): VerifiedPermissionResolution[] {
+  if (!isParentBlockerProducer(pi, toolName) || !details || typeof details !== "object") return [];
+  const records = (details as { permissionResolutions?: unknown }).permissionResolutions;
+  if (!Array.isArray(records) || records.length > MAX_PERMISSION_BLOCKERS) return [];
+  if (!records.every((entry) => entry && typeof entry === "object" && !Array.isArray(entry) &&
+    Reflect.ownKeys(entry).every(k => k === "blocker" || k === "resolution" || k === "resolvedAt") &&
+    isPermissionBlocker(entry.blocker) && entry.blocker.context === "worker" &&
+    (entry.resolution === "recovered" || entry.resolution === "superseded") &&
+    typeof entry.resolvedAt === "number" && Number.isFinite(entry.resolvedAt) && entry.resolvedAt > 0)) return [];
+  return records.map(entry => ({ blocker: compactBlocker(entry.blocker), resolution: entry.resolution, resolvedAt: entry.resolvedAt }));
+}
+
+export function permissionResolvedRecord(goalId: string, resolution: VerifiedPermissionResolution): PermissionRecord {
+  return { version: 1, kind: "permission-resolved", goalId, blocker: compactBlocker(resolution.blocker),
+    resolution: resolution.resolution, resolvedAt: resolution.resolvedAt, at: Math.floor(Date.now() / 1000) };
+}
