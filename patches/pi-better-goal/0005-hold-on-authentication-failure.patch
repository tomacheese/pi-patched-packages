diff --git a/src/provider-limit.ts b/src/provider-limit.ts
index ecde6b1..afc4027 100644
--- a/src/provider-limit.ts
+++ b/src/provider-limit.ts
@@ -11,3 +11,12 @@ export function providerLimitResetMs(message: unknown): number | undefined {
   if (!Number.isFinite(value) || value <= 0) return undefined;
   return value * (match[2]?.toLowerCase() === "h" ? 3_600_000 : 60_000);
 }
+
+/**
+ * True when an error message reports that the login was rejected (a revoked or
+ * expired OAuth token, HTTP 401). Retrying cannot succeed until the user logs in again.
+ */
+export function isAuthFailureMessage(message: unknown): boolean {
+  return typeof message === "string" &&
+    /invalidated oauth token|token_revoked|\b401\b|unauthori[sz]ed|invalid[ _-]?api[ _-]?key|authentication (?:failed|error)|please (?:log ?in|sign ?in) again/i.test(message);
+}
