{
  "name": "pi-patched-packages",
  "version": "1.0.0",
  "description": "Local patches on top of upstream pi packages, rebuilt automatically and published as the dist branch",
  "homepage": "https://github.com/tomacheese/pi-patched-packages",
  "bugs": {
    "url": "https://github.com/tomacheese/pi-patched-packages/issues"
  },
  "license": "MIT",
  "author": "Tomachi",
  "private": true,
  "repository": {
    "url": "git@github.com:tomacheese/pi-patched-packages.git",
    "type": "git"
  },
  "scripts": {
    "build": "tsx ./src/build.ts",
    "smoke": "tsx ./src/smoke.ts",
    "lint": "run-z lint:prettier,lint:eslint,lint:tsc",
    "fix": "run-z fix:prettier,fix:eslint",
    "lint:prettier": "prettier --check src",
    "lint:eslint": "eslint . -c eslint.config.mjs",
    "lint:tsc": "tsc",
    "fix:eslint": "eslint . -c eslint.config.mjs --fix",
    "fix:prettier": "prettier --write src",
    "test": "jest --runInBand --passWithNoTests --detectOpenHandles --forceExit --coverage",
    "preinstall": "npx only-allow pnpm",
    "release": "tsx ./src/release-cli.ts"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.16.118",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-promise": "7.3.0",
    "jest": "30.5.2",
    "jest-expect-message": "1.1.3",
    "pi-auto-continue": "0.4.1",
    "pi-better-goal": "0.12.1",
    "pi-better-subagents": "0.27.2",
    "pi-codex-native": "0.3.13",
    "pi-loop-monitor": "0.2.8",
    "prettier": "3.9.10",
    "run-z": "2.1.0",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "jest": {
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "setupFilesAfterEnv": [
      "jest-expect-message"
    ],
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/build.ts",
      "!src/smoke.ts",
      "!src/release-cli.ts"
    ]
  }
}
